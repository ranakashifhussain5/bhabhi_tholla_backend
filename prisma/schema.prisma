generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String?  @unique
  passwordHash String?
  rankPoints   Int      @default(0)
  /** Bumped whenever every other session should be logged out (e.g. a password change) - a refresh token embeds the version it was issued under, and is rejected once this no longer matches. */
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  participations GameParticipant[]
  reportsFiled    Report[]          @relation("ReportsFiled")
  reportsReceived Report[]          @relation("ReportsReceived")
  mutesFiled      Mute[]            @relation("MutesFiled")
  mutesReceived   Mute[]            @relation("MutesReceived")
}

model Game {
  id          String   @id @default(uuid())
  mode        String
  affectsRank Boolean
  playerCount Int
  startedAt   DateTime
  endedAt     DateTime @default(now())

  participants GameParticipant[]
  reports      Report[]
}

model GameParticipant {
  id              String  @id @default(uuid())
  gameId          String
  userId          String
  seat            Int
  position        Int
  pointsDelta     Int
  quitVoluntarily Boolean @default(false)

  game Game @relation(fields: [gameId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([gameId, seat])
}

model Report {
  id         String   @id @default(uuid())
  reporterId String
  reportedId String
  // The live room a report was filed in. A game isn't persisted (no Game
  // row exists) until it ends, so this is captured immediately; gameId is
  // backfilled by persistGameResult once that room's game is written.
  roomId     String?
  gameId     String?
  message    String
  createdAt  DateTime @default(now())

  reporter User  @relation("ReportsFiled", fields: [reporterId], references: [id])
  reported User  @relation("ReportsReceived", fields: [reportedId], references: [id])
  game     Game? @relation(fields: [gameId], references: [id])
}

model Mute {
  id        String   @id @default(uuid())
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())

  muter User @relation("MutesFiled", fields: [muterId], references: [id])
  muted User @relation("MutesReceived", fields: [mutedId], references: [id])

  @@unique([muterId, mutedId])
}
